{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "types": [
      "plug"
    ],
    "typeRoots": [
      "./node_modules"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
