{
	"private": true,
	"name": "surge-ts-workspace",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"test:rust": "cargo nextest run --workspace",
		"test:rust:ci": "cargo nextest run --workspace --profile ci",
		"lib:generate": "tsx scripts/lib/generate-default-libs.ts",
		"lib:test": "tsx --test scripts/lib/generate-default-libs.test.ts",
		"oracle:tsc": "tsc --noEmit --pretty false",
		"oracle:compare": "tsx scripts/oracle/compare-tsc.ts",
		"oracle:sweep": "tsx scripts/oracle/sweep-presets.ts",
		"oracle:test": "tsx scripts/oracle/compare-tsc.test.ts && tsx --test scripts/oracle/no-classifier-guard.test.ts && tsx --test scripts/oracle/sweep-presets.test.ts",
		"bench:compilers": "tsx scripts/bench/compare-compilers.ts",
		"bench:archive": "tsx scripts/bench/archive-run.ts",
		"bench:test": "tsx --test scripts/bench/compare-compilers.test.ts scripts/bench/archive-run.test.ts scripts/bench/allocator-bench.test.ts scripts/bench/report.test.ts scripts/bench/complexity-regression.test.ts",
		"bench:allocators": "tsx scripts/bench/allocator-bench.ts",
		"bench:complexity": "tsx scripts/bench/complexity-regression.ts",
		"bench:ky": "tsx scripts/bench/compare-compilers.ts --project .local-projects/ky --json .bench/compilers/ky.json --chart .bench/compilers/ky.svg --html .bench/compilers/ky.html",
		"bench:trpc": "tsx scripts/bench/compare-compilers.ts --project .local-projects/trpc --json .bench/compilers/trpc.json --chart .bench/compilers/trpc.svg --html .bench/compilers/trpc.html",
		"bench:zod": "tsx scripts/bench/compare-compilers.ts --project .local-projects/zod --json .bench/compilers/zod.json --chart .bench/compilers/zod.svg --html .bench/compilers/zod.html",
		"bench:ofetch": "tsx scripts/bench/compare-compilers.ts --project .local-projects/ofetch --json .bench/compilers/ofetch.json --chart .bench/compilers/ofetch.svg --html .bench/compilers/ofetch.html",
		"bench:unnamed": "tsx scripts/bench/compare-compilers.ts --project ../../nextjs/unnamed --json .bench/compilers/unnamed.json --chart .bench/compilers/unnamed.svg --html .bench/compilers/unnamed.html",
		"real:project": "tsx scripts/real-projects/measure-project.ts",
		"real:test": "tsx --test scripts/real-projects/measure-project.test.ts scripts/real-projects/ky-regression.test.ts scripts/real-projects/unnamed-regression.test.ts",
		"real:ky:test": "tsx --test scripts/real-projects/ky-regression.test.ts",
		"real:unnamed:test": "tsx --test scripts/real-projects/unnamed-regression.test.ts",
		"real:auth-kit": "tsx scripts/real-projects/measure-project.ts --name auth-kit --authKitFallback",
		"real:ky": "tsx scripts/real-projects/measure-project.ts --project .local-projects/ky --name ky --allowMissing",
		"real:trpc": "tsx scripts/real-projects/measure-project.ts --project .local-projects/trpc --name trpc --allowMissing",
		"real:unnamed": "tsx scripts/real-projects/measure-project.ts --project ../../nextjs/unnamed --name unnamed --allowMissing",
		"real:ofetch": "tsx scripts/real-projects/measure-project.ts --project .local-projects/ofetch --name ofetch --allowMissing",
		"real:zod": "tsx scripts/real-projects/measure-project.ts --project .local-projects/zod --name zod --allowMissing"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"tsx": "4.22.4",
		"typescript": "npm:typescript@7.0.2",
		"typescript-6": "npm:typescript@6.0.3"
	},
	"packageManager": "pnpm@11.13.0"
}
