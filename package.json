{
	"private": true,
	"name": "surge-ts-workspace",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"test:rust": "cargo nextest run --workspace",
		"test:rust:ci": "cargo nextest run --workspace --profile ci",
		"lib:generate": "tsx scripts/lib/generate-default-libs.ts",
		"lib:test": "tsx --test scripts/lib/generate-default-libs.test.ts",
		"oracle:tsc": "tsc --noEmit --pretty false",
		"oracle:compare": "tsx scripts/oracle/compare-tsc.ts",
		"oracle:sweep": "tsx scripts/oracle/sweep-presets.ts",
		"oracle:test": "tsx scripts/oracle/compare-tsc.test.ts && tsx --test scripts/oracle/no-classifier-guard.test.ts && tsx --test scripts/oracle/sweep-presets.test.ts",
		"bench:compilers": "tsx scripts/bench/compare-compilers.ts",
		"bench:archive": "tsx scripts/bench/archive-run.ts",
		"bench:test": "tsx --test scripts/bench/compare-compilers.test.ts scripts/bench/archive-run.test.ts",
		"real:project": "tsx scripts/real-projects/measure-project.ts",
		"real:test": "tsx --test scripts/real-projects/measure-project.test.ts",
		"real:auth-kit": "tsx scripts/real-projects/measure-project.ts --name auth-kit --authKitFallback",
		"real:trpc": "tsx scripts/real-projects/measure-project.ts --project .local-projects/trpc --name trpc --allowMissing",
		"real:unnamed": "tsx scripts/real-projects/measure-project.ts --project ../../nextjs/unnamed --name unnamed --allowMissing",
		"real:zod": "tsx scripts/real-projects/measure-project.ts --project .local-projects/zod --name zod --allowMissing"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"@typescript/native-preview": "7.0.0-dev.20260615.1",
		"tsx": "4.22.4",
		"typescript": "6.0.3"
	},
	"packageManager": "pnpm@11.7.0"
}
