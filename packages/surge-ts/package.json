{
	"name": "surge-ts",
	"version": "0.1.0",
	"description": "An embeddable TypeScript type checker written in Rust, with a familiar TypeScript Compiler API.",
	"license": "MIT OR Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/astra-void/surge-ts",
		"directory": "packages/surge-ts"
	},
	"main": "./index.cjs",
	"module": "./index.mjs",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.mjs",
			"require": "./index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"index.cjs",
		"index.mjs",
		"index.d.ts",
		"lib/",
		"*.node"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build:native": "node scripts/build-native.cjs",
		"test": "vitest run"
	},
	"devDependencies": {
		"vitest": "^5.0.1"
	}
}
